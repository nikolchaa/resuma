\template[id=professional, name=Professional, version=1]

\page{margin: 40; font-family: @font; font-size: 11; color: #1f2937}

\style[name]{font-size: 20; font-weight: bold; text-transform: uppercase; margin-bottom: 4}
\style[contact]{font-size: 10; color: #3f434c; margin-bottom: 4}
\style[heading]{font-size: 12; font-weight: bold; text-transform: uppercase;
  margin-top: 12; margin-bottom: 6; padding-bottom: 2; border-bottom: 1 #d1d5db; keep: with-next}
\style[strong]{font-weight: bold}
\style[small]{font-size: 9; color: #3f434c}
\style[text]{font-size: 10; margin-bottom: 2}
\style[entry]{margin-bottom: 4}

\header{
  \p[name]{\v{fullName}}
  \p[contact]{\join[sep=" | "]{\v{email}}{\v[nolink]{location}}{\v{phone}}}
  \p[contact]{\join[sep=" | "]{\v{linkedin}}{\v{github}}{\v{website}}}
}

\section[education]{
  \p[heading]{\label{education}}
  \entries[entry]{
    \row{\p[strong]{\v{degree}}}{\p[strong]{\v{school}}}
    \p[small]{\join[sep=" | "]{\v{location}}{\range[sep=" – "]{date}}}
    \if{gpa}{\p[small]{\label{gpa}: \v{gpa}}}
    \if{courses}{\p[small]{\label{courses}: \list[sep=", "]{courses}}}
  }
}

\section[experience]{
  \p[heading]{\label{experience}}
  \entries[entry]{
    \row{\p[strong]{\v{jobTitle}}}{\p[strong]{\v{company}}}
    \p[small]{\join[sep=" | "]{\v{location}}{\range[sep=" – "]{date}}}
    \if{description}{\p[text]{\v{description}}}
    \if{notes}{\p[text]{\lines[prefix="• "]{notes}}}
  }
}

\section[projects]{
  \p[heading]{\label{projects}}
  \entries[entry]{
    \p[strong]{\v{name}}
    \p[small]{\join[sep=" | "]{\v{date.from}}{\v[nolink]{link}}}
    \p[text]{\v{description}}
    \if{technologies}{\p[small]{\label{tech}: \list[sep=", "]{technologies}}}
  }
}

\section[awards]{
  \p[heading]{\label{awards}}
  \entries[entry]{
    \row{\p[strong]{\v{title}}}{\p[strong]{\join[sep=" | "]{\v{organizer}}{\v{location}}}}
    \p[small]{\v{date.from}}
    \if{description}{\p[text]{\v{description}}}
  }
}

\section[skills]{
  \p[heading]{\label{skills}}
  \entries[entry]{
    \p[strong]{\v{category}}
    \p[small]{\list[sep=", "]{items}}
  }
}
