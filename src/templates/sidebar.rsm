\template[id=sidebar, name=Sidebar, version=1]
\option[sidebar, type=color, default=#1f2937, label="Sidebar colour"]
\option[sidetext, type=color, default=#e5e7eb, label="Sidebar text colour"]
\option[accent, type=color, default=#0ea5a4, label="Accent colour"]

\page{margin: 36; font-family: @font; font-size: 10; color: #1f2937}

% Columns: the sidebar's background runs to the page edge and full height.
\style[side]{background: @sidebar; color: @sidetext; padding-right: 16}

% Sidebar
\style[name]{font-size: 20; font-weight: bold; line-height: 1.1; margin-bottom: 14}
\style[sidelabel]{font-size: 8; font-weight: bold; text-transform: uppercase; color: @accent; margin-bottom: 1}
\style[contact]{font-size: 9; margin-bottom: 7}
\style[sideheading]{font-size: 10; font-weight: bold; text-transform: uppercase; color: @accent;
  margin-top: 14; margin-bottom: 6; keep: with-next}
\style[sideentry]{margin-bottom: 7}
\style[sidestrong]{font-size: 9; font-weight: bold}
\style[sidesmall]{font-size: 9}

% Main column
\style[heading]{font-size: 12; font-weight: bold; text-transform: uppercase; color: #111827;
  margin-top: 4; margin-bottom: 8; padding-bottom: 3; border-bottom: 1.5 @accent; keep: with-next}
\style[entry]{margin-bottom: 8}
\style[title]{font-size: 11; font-weight: bold; color: #111827}
\style[meta]{font-size: 9; color: #4b5563; margin-bottom: 2}
\style[text]{font-size: 9.5; color: #374151; margin-top: 1}

\cols[widths="32,68", gap=22, left=side]{
  \header{
    \p[name]{\v{fullName}}
    \if{email}{\p[sidelabel]{\label{email}} \p[contact]{\v{email}}}
    \if{phone}{\p[sidelabel]{\label{phone}} \p[contact]{\v{phone}}}
    \if{location}{\p[sidelabel]{\label{location}} \p[contact]{\v[nolink]{location}}}
    \if{website}{\p[sidelabel]{\label{website}} \p[contact]{\v{website}}}
    \if{linkedin}{\p[sidelabel]{\label{linkedin}} \p[contact]{\v{linkedin}}}
    \if{github}{\p[sidelabel]{\label{github}} \p[contact]{\v{github}}}
  }

  \section[skills]{
    \p[sideheading]{\sectiontitle}
    \entries[sideentry]{
      \p[sidestrong]{\v{category}}
      \p[sidesmall]{\list[sep=", "]{items}}
    }
  }

  \section[awards]{
    \p[sideheading]{\sectiontitle}
    \entries[sideentry]{
      \p[sidestrong]{\v{title}}
      \p[sidesmall]{\join[sep=", "]{\v{organizer}}{\v{date.from}}}
    }
  }
}{
  \section[experience]{
    \p[heading]{\sectiontitle}
    \entries[entry]{
      \p[title]{\join[sep=" · "]{\v{jobTitle}}{\v{company}}}
      \p[meta]{\join[sep=" | "]{\range[sep=" – "]{date}}{\v{location}}}
      \if{description}{\p[text]{\v{description}}}
      \if{notes}{\p[text]{\lines[prefix="• "]{notes}}}
    }
  }

  \section[education]{
    \p[heading]{\sectiontitle}
    \entries[entry]{
      \p[title]{\join[sep=" · "]{\v{degree}}{\v{school}}}
      \p[meta]{\join[sep=" | "]{\range[sep=" – "]{date}}{\v{location}}}
      \if{gpa}{\p[text]{\label{gpa}: \v{gpa}}}
      \if{courses}{\p[text]{\label{courses}: \list[sep=", "]{courses}}}
    }
  }

  \section[projects]{
    \p[heading]{\sectiontitle}
    \entries[entry]{
      \p[title]{\v{name}}
      \p[meta]{\join[sep=" | "]{\v{date.from}}{\v[nolink]{link}}}
      \p[text]{\v{description}}
      \if{technologies}{\p[text]{\label{tech}: \list[sep=", "]{technologies}}}
    }
  }

  \section[*]{
    \p[heading]{\sectiontitle}
    \entries[entry]{
      \p[title]{\join[sep=" · "]{\v{title}}{\v{subtitle}}}
      \p[meta]{\join[sep=" | "]{\range[sep=" – "]{date}}{\v{location}}}
      \if{description}{\p[text]{\v{description}}}
      \if{items}{\p[text]{\lines[prefix="• "]{items}}}
    }
  }
}
